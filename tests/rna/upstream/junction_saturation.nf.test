nextflow_process {

    name "Test upstream RSeQC junction_saturation"
    script "../../../modules/nf-core/rseqc/junctionsaturation/main.nf"
    process "RSEQC_JUNCTIONSATURATION"

    tag "upstream"
    tag "rna"
    tag "junction_saturation"
    tag "small"

    test("small dataset - upstream junction_saturation") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'reverse' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.bed", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rscript = process.out.rscript[0][1]
            assert path(rscript).exists()

            // junction_saturation.py samples reads after an unseeded random.shuffle().
            // The patched module seeds Python's random module (random.seed(1)), so the
            // whole R script, every sampling point included, is reproducible. It must
            // be the reference the RustQC crosscheck compares against.
            def reference = "${projectDir}/snapshots/rna/small/rseqc/junction_saturation/junctionSaturation_plot.r"
            assert path(rscript).md5 == path(reference).md5 : \
                "R script differs from the reference ${reference}"

            snapshot(path(rscript).readLines()).match("junction_saturation_output")
        }
    }
}
