nextflow_process {

    name "Test RustQC TIN output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "tin"
    tag "small"

    test("tin - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'reverse' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def summaryFile = "${rustqcDir}/rseqc/tin/test.summary.txt"
            def xlsFile     = "${rustqcDir}/rseqc/tin/test.tin.xls"
            assert path(summaryFile).exists() : "TIN summary not found in: ${rustqcDir}"
            assert path(xlsFile).exists()     : "TIN xls not found in: ${rustqcDir}"

            // Snapshot both files for regression tracking
            // Round TIN floats to 10 decimal places to absorb last-digit
            // floating-point differences across platforms (macOS vs Linux)
            def roundFloat = { val ->
                try { String.format("%.10f", val.toDouble()) } catch (e) { val }
            }

            // summary: Bam_file, TIN(mean), TIN(median), TIN(stdev) - round cols 1-3
            def summaryLines = path(summaryFile).readLines()
            def roundedSummary = [summaryLines[0]] + summaryLines.drop(1).collect { line ->
                def cols = line.split('\t')
                [cols[0], roundFloat(cols[1]), roundFloat(cols[2]), roundFloat(cols[3])].join('\t')
            }

            // xls: geneID, chrom, tx_start, tx_end, TIN - only round TIN (col 4)
            def xlsLines = path(xlsFile).readLines()
            def header = xlsLines[0]
            def sorted = xlsLines.drop(1).sort { it.split('\t')[0] }.collect { line ->
                def cols = line.split('\t')
                [cols[0], cols[1], cols[2], cols[3], roundFloat(cols[4])].join('\t')
            }

            snapshot(
                "summary": roundedSummary,
                "tin_xls": [header] + sorted
            ).match("tin_regression")
        }
    }

    test("tin - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'reverse' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def summaryFile = "${rustqcDir}/rseqc/tin/test.summary.txt"
            def xlsFile     = "${rustqcDir}/rseqc/tin/test.tin.xls"
            assert path(summaryFile).exists() : "TIN summary not found in: ${rustqcDir}"
            assert path(xlsFile).exists()     : "TIN xls not found in: ${rustqcDir}"

            def upstreamDir = "${projectDir}/snapshots/rna/small/rseqc/tin"

            // TIN values match RSeQC tin.py (5.0.4) exactly, up to the last binary digit,
            // which upstream itself does not fix:
            //   - tin.py writes transcripts in BED order, and the GTF2BED Perl script emits
            //     transcripts with equal coordinates in Perl hash order, which changes from run
            //     to run. So rows are compared by transcript, and the summary mean/stdev (a sum
            //     over the rows in that order) may differ in the last digit.
            //   - math.log/math.exp come from the platform libm (glibc picks FMA or non-FMA
            //     code for the CPU), so a TIN value may differ by a few ulp between machines:
            //     measured on this dataset, 1 of 8,443 values differs by 2 ulp between the
            //     committed reference and tin.py on another CPU.
            // Both sides are therefore compared at 1e-12 relative (about 4,500 ulp), far below
            // any real difference; transcript IDs and coordinates must be identical.
            def tol = 1e-12

            // Summary: column 0 is the BAM file name, columns 1-3 TIN mean/median/stdev.
            CompareUtils.tsvMatch(
                path(summaryFile).readLines(),
                path("${upstreamDir}/test.summary.txt").readLines(),
                [relTolerance: tol, skipColumns: [0] as Set, trimLines: false]
            )

            // Per transcript, keyed by geneID: columns 0-3 (geneID, chrom, tx_start, tx_end)
            // identical, TIN (column 4) at the tolerance above.
            def actualLines   = path(xlsFile).readLines()
            def expectedLines = path("${upstreamDir}/test.tin.xls").readLines()
            assert actualLines[0] == expectedLines[0] : \
                "TIN xls header differs: '${actualLines[0]}' vs '${expectedLines[0]}'"
            def byId = { lines -> lines.drop(1).collectEntries { line -> def c = line.split('\t', -1); [(c[0]): c] } }
            def actualRows   = byId(actualLines)
            def expectedRows = byId(expectedLines)
            assert actualRows.size() == actualLines.size() - 1 : "Duplicate geneIDs in RustQC TIN xls"
            assert actualRows.keySet() == expectedRows.keySet() : \
                "TIN transcripts differ: ${(actualRows.keySet() - expectedRows.keySet()).size()} only in RustQC, " +
                "${(expectedRows.keySet() - actualRows.keySet()).size()} only upstream"

            def rowDiffs = expectedRows.keySet().findAll { id ->
                def a = actualRows[id], e = expectedRows[id]
                if (a.size() != e.size() || a[0..3] != e[0..3]) return true
                if (a[4] == e[4]) return false
                double x = a[4] as Double, y = e[4] as Double
                return Math.abs(x - y) > tol * Math.abs(y)
            }
            assert !rowDiffs : \
                "TIN differs for ${rowDiffs.size()} transcripts, e.g. " +
                rowDiffs.take(5).collect { "RustQC '${actualRows[it].join(' ')}' vs upstream '${expectedRows[it].join(' ')}'" }
        }
    }
}
