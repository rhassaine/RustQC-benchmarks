nextflow_process {

    name "Test RUSTQC dupradar output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "dupradar"
    tag "small"

    // ── Regression: detect changes between RustQC versions ──────────
    test("dupradar - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'reverse' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def matrixFile = "${rustqcDir}/dupradar/test_dupMatrix.txt"
            def slopeFile  = "${rustqcDir}/dupradar/test_intercept_slope.txt"
            assert path(matrixFile).exists() : "dupMatrix file not found in: ${rustqcDir}"
            assert path(slopeFile).exists()  : "intercept_slope file not found in: ${rustqcDir}"

            // Snapshot both files for regression tracking
            snapshot(
                matrix: path(matrixFile).readLines(),
                slope:  path(slopeFile).readLines()
            ).match("dupradar_regression")
        }
    }

    // ── Crosscheck: validate RustQC output matches upstream dupRadar ─
    test("dupradar - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'reverse' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def matrixFile = "${rustqcDir}/dupradar/test_dupMatrix.txt"
            def slopeFile  = "${rustqcDir}/dupradar/test_intercept_slope.txt"
            assert path(matrixFile).exists() : "dupMatrix file not found in: ${rustqcDir}"
            assert path(slopeFile).exists()  : "intercept_slope file not found in: ${rustqcDir}"

            def upstreamDir = "${projectDir}/snapshots/rna/small/dupradar"

            // dupMatrix: measured byte-identical to dupRadar, i.e. all 14 columns
            // (counts and the derived dupRate/RPK/RPKM columns, in R's number
            // formatting) for all 2,905 genes.
            assert path(matrixFile).md5 == path("${upstreamDir}/dupMatrix.txt").md5 : \
                "dupMatrix.txt differs from upstream dupRadar"

            // intercept/slope: byte-identical to dupRadar (R's cat(): 15 significant
            // digits, a space after the intercept). The upstream reference is made with
            // OpenBLAS pinned to its generic kernels (conf/modules.config), without which its
            // last digits depend on the CPU.
            assert path(slopeFile).md5 == path("${upstreamDir}/intercept_slope.txt").md5 : \
                "intercept_slope.txt differs from upstream dupRadar:\n" +
                "  RustQC:   ${path(slopeFile).readLines()}\n" +
                "  upstream: ${path("${upstreamDir}/intercept_slope.txt").readLines()}"
        }
    }
}
